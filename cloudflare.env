# Build-time addresses for the redesign Workers (2026-10-28): `npm run cf:build` loads this file.
# The APIs are development's dev-* services (they build `development`); links to another app go
# to that app's Worker. Public URLs only - never put a secret here.
ACCOUNTS_API_URL=https://dev-accounts-api.dailyminty.com
PETTY_CASH_API_URL=https://dev-pettycash-api.dailyminty.com
SUBSCRIPTION_API_URL=https://dev-subscription-api.dailyminty.com
PAYMENT_REQUEST_WEB_URL=https://payment-request.dailyminty.workers.dev
