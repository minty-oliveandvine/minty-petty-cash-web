# minty-petty-cash-web - copy to .env.local. Unset means the decided local port (lib/env.ts),
# which these repeat (the 2026-10-16 layout). Inlined at build time (next.config.ts `env`), so a
# deployment sets them before `next build`.

# Flask (Minty, accounts-api) - the hand-off that mints this app's token, My Profile.
ACCOUNTS_API_URL=http://localhost:8000
# Petty Cash's API - Django minty-petty-cash-api (/api/petty-cash/v1/...).
PETTY_CASH_API_URL=http://localhost:8010
# minty-subscription-api (Django) - the sidebar's Subscriptions
SUBSCRIPTION_API_URL=http://localhost:8001
# minty-payment-request-web - the sidebar's Bills
PAYMENT_REQUEST_WEB_URL=http://localhost:3020
