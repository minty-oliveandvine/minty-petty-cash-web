# minty-petty-cash-web - copy to .env.local. Unset means the decided local port (lib/env.ts);
# the values below are TODAY's on a workstation, until the 2026-10-14 port move lands (Flask to
# 8000, subscription-api to 8001, the petty-cash API to 8010). Inlined at build time
# (next.config.ts `env`), so a deployment sets them before `next build`.

# Flask (Minty, becoming accounts-api) - the hand-off that mints this app's token, My Profile.
# Locally Flask runs on 5001 (its Xero callback).
ACCOUNTS_API_URL=http://localhost:5001
# Petty Cash's API. Flask serves it for now (/api/petty-cash/v1/...), so the same address.
PETTY_CASH_API_URL=http://localhost:5001
# minty-subscription-api (Django) - the sidebar's Subscriptions
SUBSCRIPTION_API_URL=http://localhost:8000
# minty-payment-request-web - the sidebar's Bills
PAYMENT_REQUEST_WEB_URL=http://localhost:3020
